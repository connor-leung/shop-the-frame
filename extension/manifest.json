{
  "manifest_version": 3,
  "name": "Shop This Frame",
  "version": "1.0.0",
  "description": "Shop items from YouTube video frames",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_title": "Shop This Frame Settings",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["config.js", "contentScript.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["config.js", "background.js"]
  },
  "icons": {
    "32": "icons/shopping-logo-32x32.png",
    "64": "icons/shopping-logo-64x64.png",
    "128": "icons/shopping-logo-128x128.png",
    "512": "icons/shopping-logo-512x512.png"
  }
}
