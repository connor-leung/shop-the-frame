generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CatalogQueryCache {
  id            BigInt    @id @default(autoincrement())
  userId        String    @map("user_id")
  query         String
  productSource String    @default("shopify") @map("product_source")
  products      Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastUsedAt    DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)

  @@unique([userId, query, productSource], map: "uq_catalog_query_cache_user_query_source")
  @@index([userId, lastUsedAt(sort: Desc)], map: "idx_catalog_query_cache_user_last_used")
  @@map("catalog_query_cache")
}

model ProductAnalytics {
  id               BigInt                    @id @default(autoincrement())
  productId        String                    @unique @map("product_id")
  productUrl       String?                   @map("product_url")
  platform         String?
  impressions      Int                       @default(0)
  clicks           Int                       @default(0)
  monthlyAnalytics ProductAnalyticsMonthly[]

  @@index([impressions(sort: Desc)], map: "idx_product_analytics_impressions")
  @@map("product_analytics")
}

model ProductAnalyticsMonthly {
  id                 BigInt           @id @default(autoincrement())
  productAnalyticsId BigInt           @map("product_analytics_id")
  month              Int
  year               Int
  clicks             Int              @default(0)
  impressions        Int              @default(0)

  productAnalytics   ProductAnalytics @relation(fields: [productAnalyticsId], references: [id])

  @@unique([productAnalyticsId, month, year], map: "uq_product_analytics_monthly")
  @@index([productAnalyticsId], map: "idx_product_analytics_monthly_product")
  @@map("product_analytics_monthly")
}
