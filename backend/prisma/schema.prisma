generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AnalyticsEvent {
  id        BigInt    @id @default(autoincrement())
  type      String
  category  String?
  query     String?
  productId String?   @map("product_id")
  productUrl String?  @map("product_url")
  userId    String?   @map("user_id")
  requestId String?   @map("request_id")
  ts        DateTime  @default(now()) @db.Timestamptz(6)

  @@index([ts(sort: Desc)], map: "idx_analytics_events_ts")
  @@index([category], map: "idx_analytics_events_category")
  @@index([query], map: "idx_analytics_events_query")
  @@index([requestId], map: "idx_analytics_events_request_id")
  @@index([category, query, ts(sort: Desc)], map: "idx_analytics_events_category_query_ts")
  @@map("analytics_events")
}

model CatalogQueryCache {
  id            BigInt    @id @default(autoincrement())
  userId        String    @map("user_id")
  query         String
  productSource String    @default("shopify") @map("product_source")
  products      Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastUsedAt    DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)

  @@unique([userId, query, productSource], map: "uq_catalog_query_cache_user_query_source")
  @@index([userId, lastUsedAt(sort: Desc)], map: "idx_catalog_query_cache_user_last_used")
  @@map("catalog_query_cache")
}

model ProductView {
  id          BigInt    @id @default(autoincrement())
  userId      String    @map("user_id")
  productId   String    @map("product_id")
  productUrl  String?   @map("product_url")
  firstSeenAt DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  viewCount   Int       @default(1) @map("view_count")

  @@unique([userId, productId], map: "uq_product_views_user_product")
  @@index([userId, lastSeenAt(sort: Desc)], map: "idx_product_views_user_last_seen")
  @@map("product_views")
}

model ProductClick {
  id         BigInt    @id @default(autoincrement())
  userId     String    @map("user_id")
  requestId  String?   @map("request_id")
  category   String?
  query      String?
  productId  String    @map("product_id")
  productUrl String?   @map("product_url")
  clickedAt  DateTime  @default(now()) @map("clicked_at") @db.Timestamptz(6)

  @@index([userId, clickedAt(sort: Desc)], map: "idx_product_clicks_user_clicked_at")
  @@index([productId], map: "idx_product_clicks_product_id")
  @@map("product_clicks")
}
