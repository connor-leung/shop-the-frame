    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.3.5",
    "prisma": "^6.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
