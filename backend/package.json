{
  "name": "uoft-hacks-backend",
  "version": "1.0.0",
  "description": "Express backend for UofT Hacks",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
